--rules--

function update_rules()
	if btnp(🅾️) then
		state="top down"
		init_td()
	end
end

function draw_rules()
	cls()
	map(18,18)
	print_rules()
end
	
function print_rules()
	print("how to play",40,10,7)
	
	print("top down:",41,30,7)
	print("get close to middle",41,40,7)
	print("but dont hit it!",41,50,7)
	
	print("side view:",41,70,7)
	print("hit the middle",41,80,7)
	print("of the target",41,90,7)
	
	print("press 🅾️ to continue",20,110,7)
end
