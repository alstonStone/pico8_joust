pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--main--

function _init()
	p1_total_score=0
	p2_total_score=0
	state="top down"
	init_td()
end


function _update()
	if state=="top down" then
		update_td()
	elseif state=="side view" then
		update_sv()
	end
end


function _draw()
	if state=="top down" then
		draw_td()
	elseif state=="side view" then
		draw_sv()
	end
end

function add_scores_to_total(p1_score,p2_score)
	p1_total_score+=p1_score
	p2_total_score+=p2_score
end
-->8
--top down manager--

function init_td()
	p1_td_score=0
	p2_td_score=0
	init_player_1_td()
	init_player_2_td()
end


function update_td()
	update_player_1_td()
	update_player_2_td()
	if p1y==60 then
		score_steering()
		init_sv()
		state="side view"
	end
end


function draw_td()
	cls()
	map(1)
	draw_player_1_td()
	draw_player_2_td()
end

function score_steering()
		p1_td_score=73-p1x
		p2_td_score=p2x-40
		add_scores_to_total(p1_td_score,p2_td_score)
		print("p1: "..p1_total_score)
		print("p2: "..p2_total_score)
end
-->8
--player 1 top down--

function init_player_1_td()
	p1x=80
	p1y=120
	speed=1
	steer_strength=2
	sway=1
	bump=10
end


function update_player_1_td()
	if p1x<60 then
		p1x+=bump
	else
		sway=flr(rnd(2))
		if btn(⬅️) then
			p1x-=steer_strength
		elseif btn(➡️) then
			p1x+=steer_strength
		end
		p1x+=sway
		p1y-=speed
	end
end


function draw_player_1_td()
	spr(8,p1x,p1y)
	--print("x:"..p1x..",y:"..p1y)
	pset(44, 63, 0)--
	--pset(63, 71, 0)--
end


-->8
--player 2 top down--
--73 to 60 is scoreing pixel range of p1
-- so that range is used to pick p2
function init_player_2_td()
	p2x=32
	p2y=0
	speed=1
	score=flr(rnd(6))+6
	move_to=score+40
end


function update_player_2_td()
	p2y+=speed
	if p2x<move_to then
		p2x+=1
	end
end


function draw_player_2_td()
	spr(7,p2x,p2y)
end
-->8
--side view manager--

function init_sv()
	p1_sv_score=0
	p2_sv_score=0
	
	init_p1_sv()
end


function update_sv()
	update_p1_sv()
	if p1x==102 then
		draw_sv()
		score_lance()
		stop()
	end
end


function draw_sv()
	cls()
	map(18,0)
	draw_p1_sv()
end

function score_lance()
	p1_sv_score=20-(abs(lv+2))
	p2_sv_score=flr(rnd(5))+15
	add_scores_to_total(p1_sv_score,p2_sv_score)
	print("p1: "..p1_total_score)
	print("p2: "..p2_total_score)
end

-->8
--player 1 side view--
function init_p1_sv()
	p1x=-16
	p1y=50
	speed=1
	lv=0--lance value, angle tilt--
	frame=1
	ll=18--lance length--
	lift=0
	lift_str=3
	tip=0
end


function update_p1_sv()
	p1x+=speed
	u_lv()
	frame+=2
	if frame>5 then
		frame=1
	end
	
end

function u_lv()--update lance angle--
	if btnp(⬆️) then
		lift=lift_str
	end
	lv-=lift
	if lift>0 then
		lift-=1
	end
	if lv>10then
		lv=10
	end
	lv+=1
end


function draw_p1_sv()
	spr(frame,p1x,p1y,2,2)
	d_lance()
end


function d_lance()
	lh=p1y+4
	lx=p1x+3
	lx1=lx
	ly1=lh
	lx2=lx1+ll
	ly2=ly1+lv
	tip=ly2
	dx=lx2-lx1
	dy=ly2-ly1
	if dx>0 then
		xsign=1
	else
		xsign=-1
	end
		if dy>0 then
		ysign=1
	else
		ysign=-1
	end
	dx=abs(dx)
	dy=abs(dy)
	if dx>dy then
		xx=xsign
		xy=0
		yx=0
		yy=ysign
	else
		dx=dy
		dy=dx
	end
	d=2*dy-dx
	y=0
	for x=0,dx+1 do
		cx=lx1+(x*xx)+(y*yx)
		cy=ly1+(x*xy)+(y*yy)
		if x==3 then--draw arm--
			pset(cx, cy, 5)
		elseif x==dx-3 or x==dx-2 then--draw flag--
			pset(cx, cy, 13)
			pset(cx, cy+1, 12)
			pset(cx, cy+2, 12)
		else--draw lance--
			pset(cx, cy, 13)
		end
		if d>=0 then
			y+=1
			d-=2*dx
		end
		d+=2*dy
	end
end

