pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--main--

function _init()
	game_score={}
	
--	init_sb()
--	state="scoreboard"
	
	state="title"
	init_ts()
end


function _update()
	if state=="top down" then
		update_td()
	elseif state=="side view" then
		update_sv()
	elseif state=="scoreboard" then
		update_sb()
	elseif state=="title" then
		update_ts()
	elseif state=="wait" then
		update_wt()
	elseif state=="rules" then
		update_rules()
	end
end


function _draw()
	if state=="top down" then
		draw_td()
	elseif state=="side view" then
		draw_sv()
	elseif state=="scoreboard" then
		draw_sb()
	elseif state=="title" then
		draw_ts()
	elseif state=="rules" then
		draw_rules()
	end
end

function add_scores_to_total(p1_score,p2_score)
	p1_total_score+=p1_score
	p2_total_score+=p2_score
end
-->8
--top down manager--

function init_td()
	sfx(-1,1)
	sfx(0,1)
	p1_total_score=0
	p2_total_score=0
	p1_td_score=0
	p2_td_score=0
	init_player_1_td()
	p2_exists=false
	camera_y=16
	wait=.5*60
	scored=false
end


function update_td()
	if p1y==60 then
		if scored!=true then
			sfx(-1,1)
			score_steering()
			scored=true
		end
		if wait>0 then
			wait-=1
		else
			
			init_sv()
			state="side view"
		end
	else
		update_player_1_td()
		if camera_y>0 then
			camera_y-=.25
			p1y+=1
		else
			if p2_exists==false then
					init_player_2_td()
					p2_exists=true
				end
		end
		if p2_exists==true then
			update_player_2_td()
		end
	end
end


function draw_td()
	cls()
	map(1,camera_y)
	draw_player_1_td()
	if p2_exists==true then
		draw_player_2_td()
	end
	if scored==true then
		print(p2_total_score,30,50,0)
		print(p1_total_score,80,50,0)
	end
end

function score_steering()
		p1_td_score=73-ceil(p1x)  
		p2_td_score=p2x-40
		add_scores_to_total(p1_td_score,p2_td_score)
end
-->8
--player 1 top down--

function init_player_1_td()
	p1x=65
	p1y=120
	speed=1
	steer=0
	steer_str=.75
	sway=.5
	bump=0
	bump_str=6
	wait_time=1
end


function update_player_1_td()
	
	if p1x>75 then
		p1x=75
	elseif p1x<60 then
		bump=bump_str
	end
	p1x+=bump
	if bump>0 then
		bump-=1
	end
	
	if btn(❎) then
		steer=steer_str
	end
	p1x-=steer
	if steer>0 then
		steer-=1
	end
	p1x+=sway
	p1y-=speed
end


function draw_player_1_td()
	spr(9,p1x,p1y)
end


-->8
--player 2 top down--
--73 to 60 is scoreing pixel range of p1
-- so that range is used to pick p2
function init_player_2_td()

	speed=1
	score=flr(rnd(6))+6
	move_to=score+40
	p2x=move_to
	p2y=0
end


function update_player_2_td()
	p2y+=speed
	if p2x<move_to then
		p2x+=1
	end
end


function draw_player_2_td()
	spr(24,p2x,p2y)
end
-->8
--side view manager--

function init_sv()
	sfx(-1,1)
	sfx(0,1)
	p1_sv_score=0
	p2_sv_score=0
	init_p1_sv()
	wait=.5*60
	scored=false
end


function update_sv()
	
	if p1x>=102 then
		sfx(-1,1)
		
		if scored==true then
			if wait>0 then
				wait-=1
			else
			init_sb()
			state="scoreboard"
			end
		else
			score_lance()
		end
	else
		update_p1_sv()
		draw_sv()
	end
	
end


function draw_sv()
	cls()
	map(18,0)
	draw_p1_sv()
	if scored==true then
		print("p1: "..p1_total_score,60,30,0)
		print("p2: "..p2_total_score,60,40,0)
	end
end

function score_lance()
	p1_sv_score=20-(abs(lv+2))
	p2_sv_score=flr(rnd(5))+15
	add_scores_to_total(p1_sv_score,p2_sv_score)

	scored=true
end

-->8
--player 1 side view--
function init_p1_sv()
	p1x=-32
	p1y=50
	speed=1
	lv=0--lance value, angle tilt--
	frame=1
	ll=18--lance length--
	lift=0
	lift_str=3
	tip=0
end


function update_p1_sv()
	p1x+=speed
	u_lv()
	frame+=2
	if frame>5 then
		frame=1
	end
	
	
end

function u_lv()--update lance angle--
	if btn(❎) then
		lift=lift_str
	end
	lv-=lift
	if lift>0 then
		lift-=1
	end
	if lv>10then
		lv=10
	elseif lv<-15  then
		lv=-15
	end
	lv+=1
end


function draw_p1_sv()
	spr(frame,p1x,p1y,2,2)
	d_lance()
end


function d_lance()
	lh=p1y+4
	lx=p1x+3
	lx1=lx
	ly1=lh
	lx2=lx1+ll
	ly2=ly1+lv
	tip=ly2
	dx=lx2-lx1
	dy=ly2-ly1
	if dx>0 then
		xsign=1
	else
		xsign=-1
	end
		if dy>0 then
		ysign=1
	else
		ysign=-1
	end
	dx=abs(dx)
	dy=abs(dy)
	if dx>dy then
		xx=xsign
		xy=0
		yx=0
		yy=ysign
	else
		dx=dy
		dy=dx
	end
	d=2*dy-dx
	y=0
	for x=0,dx+1 do
		cx=lx1+(x*xx)+(y*yx)
		cy=ly1+(x*xy)+(y*yy)
		if x==3 then--draw arm--
			pset(cx, cy, 5)
		elseif x==dx-3 or x==dx-2 then--draw flag--
			pset(cx, cy, 13)
			pset(cx, cy+1, 12)
			pset(cx, cy+2, 12)
		else--draw lance--
			pset(cx, cy, 13)
		end
		if d>=0 then
			y+=1
			d-=2*dx
		end
		d+=2*dy
	end
end

-->8
--scoreboard--

--sb=scoreboard--
function init_sb()
	sfx(-1,1)
	p1ts=p1_total_score
	p2ts=p2_total_score
	game_over=false
	winner=" test "
	text_out_1="p1: "..p1ts.."  vs  p2: "..p2ts
	if p1ts>=p2ts then
		winner="p1"
		add(game_score,1)
	else
		winner="p2"
		add(game_score,2)
	end
		s1=14
		s2=14
		s3=14
		round_count=1
		p1c=0
		p2c=0
		foreach(game_score,set_spr)
		if p1c>=2 or p2c>=2 then
			game_over=true
		end
			
		
end


function update_sb()
	if btnp(🅾️) then
		if game_over==true then
			run()
		else
			state="top down"
			init_td()
		end
	end
end


function draw_sb()
	cls()
                              
	spr(s1,31,20,2,2)
	spr(s2,52,20,2,2)
	spr(s3,73,20,2,2)
	if game_over==true then
		print(winner.." wins the game",30,63,7)
	else
		print(winner.." wins the round",30,63,7)
	end
	print("press 🅾️ to continue",20,90,7)
end

function set_spr(value)
	spr_num=0
	if value==1 then
		spr_num=12
		p1c+=1
	elseif value==2 then
		spr_num=10
		p2c+=1
	end
	
	if round_count==1 then
		s1=spr_num
	elseif round_count==2 then
		s2=spr_num
	elseif round_count==3 then
		s3=spr_num
	end
	
	round_count+=1
end
